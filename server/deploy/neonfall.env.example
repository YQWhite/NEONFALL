HOST=127.0.0.1
PORT=8787
NF_DATA_DIR=/www/server/neonfall-data
NF_DIST_DIR=/www/wwwroot/neonfall/dist
NF_SEED_DIR=/www/wwwroot/neonfall/samples-converted
NF_MAX_UPLOAD_MB=256
NF_MAX_STORAGE_MB=20480
NF_UPLOADS=authenticated
NF_TRUST_PROXY=1
NF_CORS_ORIGINS=https://game.example.com,neonfall://index.html,null,http://localhost,https://localhost,capacitor://localhost
# Optional command-line repository administrator. Generate your own random value.
# NF_ADMIN_TOKEN=
# Optional email verification. Normal accounts work without SMTP.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@example.com
# SMTP_PASS=
# MAIL_FROM=noreply@example.com
